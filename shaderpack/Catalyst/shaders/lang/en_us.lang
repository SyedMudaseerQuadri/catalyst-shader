# Catalyst — English UI strings. Only the 3 visual + 5 performance preset names are ever shown as presets.

# ---- Performance presets (Iris profile button)
profile.PERFORMANCE=Performance
profile.PERFORMANCE.comment=Lowest cost. Minimum target: RTX 3050 (8GB) at 1080p.
profile.BALANCED=Balanced
profile.BALANCED.comment=Recommended for most systems.
profile.QUALITY=Quality
profile.QUALITY.comment=Softer, wider shadows at higher cost.
profile.ULTRA=Ultra
profile.ULTRA.comment=High-end quality.
profile.CINEMATIC=Cinematic
profile.CINEMATIC.comment=Maximum validated quality. For screenshots and powerful GPUs.

# ---- Visual preset
option.VISUAL_PRESET=Visual Style
option.VISUAL_PRESET.comment=Artistic direction. Independent of the performance preset. Sliders below adjust on top of it.
value.VISUAL_PRESET.0=Vanilla Enhanced
value.VISUAL_PRESET.1=Natural / Realistic
value.VISUAL_PRESET.2=Cinematic

# ---- Screens
screen.LIGHTING=Lighting
screen.SHADOWS_SCREEN=Shadows
screen.MATERIALS=Materials
screen.ATMOSPHERE=Atmosphere
screen.WEATHER=Weather & Wind
screen.WATER=Water
screen.COLOR=Color & Exposure
screen.IMAGE=Anti-Aliasing
screen.DEBUG=Debug

# ---- Lighting
option.SUN_INTENSITY=Sunlight
option.SUN_INTENSITY.comment=Strength of direct sun and moon light, relative to the visual style.
option.AMBIENT_INTENSITY=Sky Ambient
option.AMBIENT_INTENSITY.comment=Strength of light from the sky in shade.
option.BLOCKLIGHT_INTENSITY=Block Light
option.BLOCKLIGHT_INTENSITY.comment=Strength of torches, lanterns and other light sources.
option.EMISSIVE_INTENSITY=Emissive Glow
option.EMISSIVE_INTENSITY.comment=How strongly light-emitting blocks glow.
option.NIGHT_VISIBILITY=Night Brightness
option.NIGHT_VISIBILITY.comment=Moonlight and night-sky brightness. Never goes below a readable minimum.

# ---- Shadows
option.SHADOWS=Shadows
option.SHADOWS.comment=Sun and moon shadows. Turning this off gives a large performance gain.
option.shadowMapResolution=Shadow Resolution
option.shadowMapResolution.comment=Sharper shadows at higher values. Uses more VRAM.
option.shadowDistance=Shadow Distance
option.shadowDistance.comment=How far shadows reach, in blocks.
option.SHADOW_FILTER=Shadow Filtering
option.SHADOW_FILTER.comment=Smoothness of shadow edges.
value.SHADOW_FILTER.0=Hard
value.SHADOW_FILTER.1=Soft (4 samples)
value.SHADOW_FILTER.2=Softer (8 samples)
value.SHADOW_FILTER.3=Smoothest (16 samples)
option.SHADOW_SOFTNESS=Shadow Softness
option.SHADOW_SOFTNESS.comment=Width of the soft shadow edge.
option.sunPathRotation=Sun Path Angle
option.sunPathRotation.comment=Tilts the sun's path so shadows are never perfectly axis-aligned.

# ---- Materials
option.MATERIAL_MAPS=Resource Pack Materials
option.MATERIAL_MAPS.comment=Use normal and specular maps (LabPBR 1.3) from your resource pack. Has no effect with vanilla textures.
option.SPECULAR_INTENSITY=Reflections
option.SPECULAR_INTENSITY.comment=Strength of shine and sky reflections on surfaces with material data.

# ---- Atmosphere
option.FOG_DENSITY=Fog Density
option.FOG_DENSITY.comment=Distance haze, relative to the visual style. Rain always adds more.
option.CLOUD_STYLE=Clouds
option.CLOUD_STYLE.comment=Catalyst clouds are volumetric, cast shadows and follow the weather. Costs more on lower profiles.
value.CLOUD_STYLE.0=Off
value.CLOUD_STYLE.1=Vanilla
value.CLOUD_STYLE.2=Catalyst
option.CLOUD_COVERAGE=Cloud Amount
option.CLOUD_COVERAGE.comment=How cloudy clear weather is. Rain and storms always add more.
option.CLOUD_SHADOW_STRENGTH=Cloud Shadows
option.CLOUD_SHADOW_STRENGTH.comment=How dark the shadows of passing clouds are (Catalyst clouds only).

# ---- Weather
option.WEATHER_WETNESS=Rain Wetness
option.WEATHER_WETNESS.comment=Surfaces darken and shine after rain, then dry slowly. Puddles form on flat ground.
option.SNOW_ACCUMULATION=Snow Cover
option.SNOW_ACCUMULATION.comment=Snow settles on the tops of blocks while it snows, and melts away slowly afterwards.
option.FOLIAGE_MOTION=Foliage Motion
option.FOLIAGE_MOTION.comment=Grass, plants and leaves sway in gusty wind. Stronger in rain and storms. 0 = still.

# ---- Water
option.WATER_WAVE_STRENGTH=Waves
option.WATER_WAVE_STRENGTH.comment=Wave size. Waves already grow with wind, rain and storms. 0 = mirror-calm.
option.WATER_TURBIDITY=Water Murkiness
option.WATER_TURBIDITY.comment=How quickly water absorbs light with depth. Swamps are always murkier than oceans.
option.CAUSTICS_STRENGTH=Caustics
option.CAUSTICS_STRENGTH.comment=Rippling light patterns on surfaces under water (needs Shadows).
option.WATER_REFLECTIONS=Terrain Reflections
option.WATER_REFLECTIONS.comment=Water reflects terrain on screen. Off: only sky and clouds are reflected (faster).
option.UNDERWATER_SHAFTS=Underwater Light Shafts
option.UNDERWATER_SHAFTS.comment=Sunbeams in the water when you dive (needs Shadows).
option.VIEW_DROPLETS=Water Droplets
option.VIEW_DROPLETS.comment=Water runs down the view for a few seconds after you surface.

# ---- Color
option.EXPOSURE_BIAS=Exposure
option.EXPOSURE_BIAS.comment=Overall brightness in stops.
option.EXPOSURE_ADAPTATION=Eye Adaptation
option.EXPOSURE_ADAPTATION.comment=How much brightness adjusts between dark and bright places. Low keeps interiors and caves naturally darker.
option.SATURATION=Saturation
option.CONTRAST=Contrast

# ---- Anti-aliasing
option.TAA=Temporal Anti-Aliasing
option.TAA.comment=Smooths jagged edges and shimmering leaves and shadows by reusing previous frames. Fast-moving mobs may leave a faint trail.

# ---- Debug
option.DEBUG_VIEW=Debug View
option.DEBUG_VIEW.comment=Development views of internal data. Keep Off for normal play.
value.DEBUG_VIEW.0=Off
value.DEBUG_VIEW.1=Albedo
value.DEBUG_VIEW.2=Normals
value.DEBUG_VIEW.3=Light Levels
value.DEBUG_VIEW.4=Materials
value.DEBUG_VIEW.5=Depth
value.DEBUG_VIEW.6=Sun Shadow
value.DEBUG_VIEW.7=Smoothness
